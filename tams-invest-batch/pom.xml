<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.joyintech</groupId>
        <artifactId>batch-base</artifactId>
        <version>2.1.6.3</version>
    </parent>
    <artifactId>tams-invest-batch</artifactId>
    <name>tams-invest-batch</name>
    <packaging>jar</packaging>
    <version>2.0</version>
    <properties>
        <jackson.version>2.9.2</jackson.version>
        <framework.version>0.0.4</framework.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>batch-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-invest-interf</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>joyintech-system</artifactId>
            <version>0.0.4</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-invest-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--<dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-valuation-common</artifactId>
            <version>2.0.0</version>
        </dependency>-->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-data</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-log</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-security</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>joyintech-system</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>joyintech-workflow</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-business-common</artifactId>
            <version>3.0.4</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-touguan-asset</artifactId>
            <version>3.0.4</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
		<!-- 打包源代码插件 -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-source-plugin</artifactId>
               <version>2.4</version>
               <configuration>
                  <attach>true</attach>
               </configuration>
               <executions>
                  <execution>
                     <phase>compile</phase>
                     <goals>
                        <goal>jar</goal>
                     </goals>
                  </execution>
               </executions>
            </plugin>

            <!--<plugin>-->
                <!--<groupId>org.apache.maven.plugins</groupId>-->
                <!--<artifactId>maven-compiler-plugin</artifactId>-->
                <!--<configuration>-->
                    <!--<source>1.8</source>-->
                    <!--<target>1.8</target>-->
                    <!--<encoding>UTF-8</encoding>-->
                <!--</configuration>-->
            <!--</plugin>-->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.joyintech.tams.invest.batch.InvestBatchApplication</mainClass>
					<classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--<plugin>-->
                <!--<groupId>org.apache.maven.plugins</groupId>-->
                <!--<artifactId>maven-jar-plugin</artifactId>-->
                <!--<configuration>-->
                    <!--<excludes>-->
                        <!--<exclude>/**/ServletInitializer.class</exclude>-->
                        <!--<exclude>/**/banner.txt</exclude>-->
                    <!--</excludes>-->
                <!--</configuration>-->
            <!--</plugin>-->
        </plugins>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.properties</include>
                    <include>**/*.ini</include>
                    <include>**/*.yml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
