<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tams-valuation-common</artifactId>
	<version>3.0.1</version>
	<name>tams-valuation-common</name>
	<description>估值核算共通</description>

	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.4</version>
	</parent>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>dom4j</groupId>
			<artifactId>dom4j</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.albfernandez</groupId>
			<artifactId>javadbf</artifactId>
			<version>1.5.1</version>
		</dependency>
		<dependency>
		   <groupId>com.joyintech</groupId>
		   <artifactId>dc-client</artifactId>
		   <version>3.2</version>
		</dependency>
		<dependency>
		   <groupId>net.sf</groupId>
		   <artifactId>jasperreports</artifactId>
		   <version>6.4.31</version>
		</dependency>
		 <dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>fastjson</artifactId>
			<version>1.2.70</version>
		</dependency>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.9.9</version>
		</dependency>
		<dependency>
			<groupId>org.eweb4j</groupId>
			<artifactId>fel</artifactId>
			<version>0.8</version>
		</dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-calculation</artifactId>
			<version>2.0.6</version>
            <exclusions>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-data</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-log</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-security</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>joyintech-system</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>joyintech-workflow</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
	</dependencies>
	<build>
	   <plugins>
		  <!-- 打包源代码插件 -->
		  <plugin>
			 <groupId>org.apache.maven.plugins</groupId>
			 <artifactId>maven-source-plugin</artifactId>
			 <version>2.4</version>
			 <configuration>
				<attach>true</attach>
			 </configuration>
			 <executions>
				<execution>
				   <phase>compile</phase>
				   <goals>
					  <goal>jar</goal>
				   </goals>
				</execution>
			 </executions>
		  </plugin>
	   </plugins>
	</build>
</project>
