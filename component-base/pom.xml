<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>component-base</artifactId>
	<version>0.0.1</version>
	<name>component-base</name>
	<description>基础组件库</description>

	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
	<properties>
		<java.version>1.8</java.version>
		<junit.version>4.12</junit.version>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-core</artifactId>
		</dependency>
        <dependency>
          <groupId>com.joyintech</groupId>
          <artifactId>framework-dtx</artifactId>
        </dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-security</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-tools</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
        </dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
			<!-- 打包源代码插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<attach>true</attach>
				</configuration>
				<executions>
					<execution>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<!-- 所有接口类作为一个jar -->
					<execution>
						<id>interf</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>interf</classifier>
							<excludes>
								<!--注意这玩意从编译结果目录开始算目录结构 -->
								<exclude>**/**/impl/**</exclude>
							</excludes>
						</configuration>
					</execution>
					<!-- authorize.jar -->
					<execution>
						<id>authorize</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>authorize</classifier>
							<includes>
								<include>**/authorize/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- basic.jar -->
					<execution>
						<id>basic</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>basic</classifier>
							<includes>
								<include>**/basic/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- command.jar -->
					<execution>
						<id>command</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>command</classifier>
							<includes>
								<include>**/command/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- control.jar -->
					<execution>
						<id>control</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>control</classifier>
							<includes>
								<include>**/control/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- core.jar -->
					<execution>
						<id>core</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>core</classifier>
							<includes>
								<include>**/core/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- entrust.jar -->
					<execution>
						<id>entrust</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>entrust</classifier>
							<includes>
								<include>**/entrust/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- financeproduct.jar -->
					<execution>
						<id>financeproduct</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>financeproduct</classifier>
							<includes>
								<include>**/financeproduct/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- group.jar -->
					<execution>
						<id>group</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>group</classifier>
							<includes>
								<include>**/group/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- liquidation.jar -->
					<execution>
						<id>liquidation</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>liquidation</classifier>
							<includes>
								<include>**/liquidation/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- ratemarket.jar -->
					<execution>
						<id>ratemarket</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>ratemarket</classifier>
							<includes>
								<include>**/ratemarket/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- risk.jar -->
					<execution>
						<id>risk</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>risk</classifier>
							<includes>
								<include>**/risk/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- valuation.jar -->
					<execution>
						<id>valuation</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>valuation</classifier>
							<includes>
								<include>**/valuation/impl/**</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
