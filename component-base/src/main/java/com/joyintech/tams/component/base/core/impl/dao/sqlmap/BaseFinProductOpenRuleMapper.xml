     <delete id="delete" parameterType="com.joyintech.tams.component.base.core.dto.BaseFinProductOpenRuleDto">
     delete from 
     	FIN_OPEN_RULE
     <where>
     	CASH_ID = #{cashId,jdbcType=VARCHAR}
		<if test="openType != null and !openType.equals('')">
		AND OPEN_TYPE = #{openType,jdbcType=VARCHAR}
		</if>
	</where>
