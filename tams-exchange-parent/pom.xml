    <dependencies>

<!--        <dependency>-->
<!--            <groupId>com.joyintech</groupId>-->
<!--            <artifactId>joyintech-system</artifactId>-->
<!--        </dependency>-->
    </dependencies>
    <build>
        <plugins>
            <!-- 打包源代码插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
