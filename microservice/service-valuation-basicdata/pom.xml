<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
    <artifactId>service-valuation-basicdata</artifactId>
    <version>3.0.1</version>
    <name>service-valuation-basicdata</name>
    <description>估值核算资产管理</description>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>framework-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>framework-data</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>service-valuation-basicdata</finalName>
        <plugins>
            <!-- 打包源代码插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

<!--            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    &lt;!&ndash;for war&ndash;&gt;
                    &lt;!&ndash; <mainClass>org.springframework.boot.loader.WarLauncher</mainClass>&ndash;&gt;
                    &lt;!&ndash; <addResources>true</addResources>&ndash;&gt;
                    &lt;!&ndash; <classifier>exec</classifier> &ndash;&gt;
                    &lt;!&ndash; <fork>true</fork> &ndash;&gt;&lt;!&ndash; 如果没有该项配置，devtools不会起作用，即应用不会restart &ndash;&gt;
                </configuration>
            </plugin>-->
        </plugins>
    </build>
</project>
