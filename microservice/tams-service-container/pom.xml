<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tams-service-container</artifactId>
	<version>2.1.1</version>
	<description>此功能的目的是集成各个微服务,将各个微服务的启动类、配置文件集中化，让各个微服务只写业务代码</description>

	<dependencies>
		<dependency>
			<groupId>com.oracle</groupId>
			<artifactId>ojdbc6</artifactId>
			<version>11.2.0.3</version>
		</dependency>

		<!-- 公共依赖 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>component-base</artifactId>
			<version>0.0.1</version>
		</dependency>

		<!-- 接口服务 -->
		<dependency>
		  <groupId>com.joyintech.service</groupId>
		  <artifactId>service-interf</artifactId>
		  <version>1.1.0</version>
		</dependency>

		<!-- 集成产品端服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-product</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 资产管理服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-asset</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 基础数据服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-basicdata</artifactId>
			<version>2.1.1.3</version>
		</dependency>

		<!-- 中债一期 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-chb</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 中债三期 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-chb3</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 共通服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-common</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 信批服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-disclosure</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 文档管理 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-document</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 投资委托 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-entrust</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 投管接口服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-invest-interf</artifactId>
			<version>0.1.1</version>
		</dependency>

		<!-- 人行报表服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-pbc</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 存续期管理 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-period</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 投资组合服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-portfolio</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 报表管理服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-report</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 风险管理服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-risk</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 风险REDIS管理服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-risk-redis</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 风险接口服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-risk-redis-inf</artifactId>
			<version>1.1.0</version>
		</dependency>

		<!-- 清算管理 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-settle</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 中债共通服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-svrcom</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 投资交易 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-trade</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 估值核算 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-valuation</artifactId>
			<version>3.0.1</version>
		</dependency>
		<!-- 估值核算-估值模型 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-valuation-valmodel</artifactId>
			<version>3.0.1</version>
		</dependency>
		<!-- 估值核算 - 减值模型 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-valuation-lossmodel</artifactId>
			<version>3.0.1</version>
		</dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-valuation-basicdata</artifactId>
			<version>3.0.1</version>
		</dependency>
		<!--银行间上下行-->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-bankuplink</artifactId>
			<version>2.0.1</version>
		</dependency>

<!--		&lt;!&ndash; 场内交易&ndash;&gt;-->
		<!-- <dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-exchange</artifactId>
			<version>0.0.1</version>
		</dependency> -->
		<!-- 行情 -->
		<!-- <dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-quote-new</artifactId>
			<version>0.0.1</version>
		</dependency> -->
				<!-- 公共基础数据 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-common-basicdata</artifactId>
			<version>2.1.1.3</version>
		</dependency>
		<!-- 引入Actuator监控依赖 <dependency> <groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId> </dependency> -->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>

			<!-- 打包源代码插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<configuration>
					<attach>true</attach>
				</configuration>
				<executions>
					<execution>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
			</resource>
			<resource>
				<directory>${project.basedir}/src/main/resources</directory>
				<targetPath>${project.build.outputDirectory}</targetPath>
			</resource>
		</resources>
	</build>
</project>
