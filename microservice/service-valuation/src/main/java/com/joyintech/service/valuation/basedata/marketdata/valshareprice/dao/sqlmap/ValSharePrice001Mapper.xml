    </sql>
    <sql id="Sql_All_Data" >
        select 
        <include refid="com.joyintech.service.valuation.basedata.marketdata.valshareprice.dao.ValSharePrice001Mapper.Base_Column_List" />
        from MST_SHARE_PRICE
    </sql>
    <sql id="Sql_All_Effective_Data" >
        select 
        <include refid="com.joyintech.service.valuation.basedata.marketdata.valshareprice.dao.ValSharePrice001Mapper.Base_Column_List" />
        from MST_SHARE_PRICE
    </sql>
    <select id="getLatelyShareById" resultMap="BaseResultMap" parameterType="Map" >
        select 
        <include refid="com.joyintech.service.valuation.basedata.marketdata.valshareprice.dao.ValSharePrice001Mapper.Base_Column_List" />
        from MST_SHARE_PRICE
        where SHARES_ID = #{sharesId,jdbcType=VARCHAR}
        	and  deal_date= (select max(deal_date) from mst_share_price 
          						where to_char(DEAL_DATE,'yyyy-MM-dd') &lt; #{dealDateString}
          						and SHARES_ID = #{sharesId,jdbcType=VARCHAR}) 
    </select>
    
   	<select id="select" resultMap="BaseResultMap" parameterType="Map" >
        select  distinct
        a.SHARES_ID 			SHARES_ID, 
        a.DEAL_DATE 			DEAL_DATE, 
        a.CCY 					CCY, 
        a.PRE_CLOSE_PRICE 		PRE_CLOSE_PRICE, 
        a.OPEN_PRICE 			OPEN_PRICE, 
        a.HIGH_PRICE 			HIGH_PRICE, 
        a.LOW_PRICE 			LOW_PRICE, 
        a.CLOSE_PRICE 			CLOSE_PRICE, 
        a.S_SHARES 				S_SHARES, 
        a.C_SHARES 				C_SHARES, 
        a.CHANGE 				CHANGE, 
        a.CHANGE_PERCENT 		CHANGE_PERCENT, 
        a.DEAL_VALUME 			DEAL_VALUME, 
        a.DEAL_AMOUNT 			DEAL_AMOUNT, 
        a.AVG_PRICE 			AVG_PRICE, 
        a.PRE_CLOSE_PRICE_ADJ 	PRE_CLOSE_PRICE_ADJ, 
        a.OPEN_PRICE_ADJ 		OPEN_PRICE_ADJ, 
        a.HIGH_PRICE_ADJ 		HIGH_PRICE_ADJ, 
        a.LOW_PRICE_ADJ 		LOW_PRICE_ADJ, 
        a.CLOSE_PRICE_ADJ 		CLOSE_PRICE_ADJ, 
        a.FACTOR_ADJ 			FACTOR_ADJ, 
        a.TRADE_STATUS 			TRADE_STATUS,
        a.PE                    pe,
        a.PB                    pb,
        a.INPUT_TYPE 			INPUT_TYPE, 
        a.CREATE_USER 			CREATE_USER, 
        a.CREATE_DEPT 			CREATE_DEPT, 
        a.CREATE_TIME 			CREATE_TIME, 
        a.UPDATE_USER 			UPDATE_USER, 
        a.UPDATE_TIME 			UPDATE_TIME,
        b.finprod_abbr 			finprod_abbr
        from mst_share_price a 
        left join fin_product b on a.shares_id=b.finprod_market_id
        <where> 
         <if test="sharesId != null and !sharesId.equals('')" >
               and SHARES_ID =#{sharesId}
          </if>
          <if test="dealDateString != null and !dealDateString.equals('')" >
            and  to_char(DEAL_DATE,'yyyy-MM-dd') =#{dealDateString}
          </if>
         </where>
    </select>
    
    <resultMap id="finprodIdMap" type="com.joyintech.framework.select.SelectOptionDto">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="text" property="text" jdbcType="VARCHAR"/>
        <association property="object" javaType="java.util.Map">
            <result column="FINPROD_NAME" property="finprodName" jdbcType="VARCHAR"/>
            <result column="FINPROD_ABBR" property="finprodAbbr" jdbcType="VARCHAR"/>
            <!-- <result column="s_shares" property="sShares" jdbcType="VARCHAR"/>
            <result column="c_shares" property="cShares" jdbcType="VARCHAR"/> -->
        </association>
    </resultMap>
    <select id="getFinprodIdForAdd" resultMap="finprodIdMap">
        SELECT
        T1.FINPROD_MARKET_ID 		id,
        T1.FINPROD_MARKET_ID 		text,
        T1.FINPROD_NAME,
        T1.FINPROD_ABBR
        <!-- ,
        t2.s_shares,
        t2.c_shares -->
        FROM
        FIN_PRODUCT T1
       <!--  LEFT JOIN
        mst_share_price T2
        ON T1.FINPROD_ID = t2.shares_id -->
        <where>
            (T1.FINPROD_TYPE = #{planasset} || T1.FINPROD_TYPE2 = #{planasset})
            <if test="search != null and !search.equals('')">
                and (T1.FINPROD_ID like concat('%',concat(#{search},'%'))
                	or T1.FINPROD_MARKET_ID like concat('%',concat(#{search},'%')) )
            </if>
            <if test="initValue != null and initValue != ''">
		           AND (T1.FINPROD_MARKET_ID = #{initValue}
		           		or T1.FINPROD_ID = #{initValue})
	       </if>
        </where>
    </select>
</mapper>