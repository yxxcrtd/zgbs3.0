    <sql id="Base_Column_List" >
        SHARES_ID  			SHARES_ID,
        DEAL_DATE       	DEAL_DATE,
        CCY             	CCY,
        PRE_CLOSE_PRICE 	PRE_CLOSE_PRICE, 
        OPEN_PRICE 			OPEN_PRICE, 
        HIGH_PRICE 			HIGH_PRICE, 
        LOW_PRICE 			LOW_PRICE, 
        CLOSE_PRICE 		CLOSE_PRICE, 
        S_SHARES 			S_SHARES, 
        C_SHARES 			C_SHARES, 
        CHANGE 				CHANGE, 
        CHANGE_PERCENT 		CHANGE_PERCENT, 
        DEAL_VALUME 		DEAL_VALUME, 
        DEAL_AMOUNT 		DEAL_AMOUNT, 
        AVG_PRICE 			AVG_PRICE, 
