<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>service-basicdata</artifactId>
	<version>2.1.1.3</version>
	<name>service-basicdata</name>
	<description>基础数据服务</description>

	
	<properties>
		<start-class>com.joyintech.service.basicdata.BasicDataApplication</start-class>
		<hibernate.version>5.3.6.Final</hibernate.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
		
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
        </dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>component-base</artifactId>
			<version>0.0.1</version>
		</dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-log</artifactId>
		</dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-data</artifactId>
		</dependency>
	</dependencies>


	<build>
		<finalName>service-basicdata</finalName>
		<plugins>
			<!-- 打包源代码插件 -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-source-plugin</artifactId>
               <version>2.4</version>
               <configuration>
                  <attach>true</attach>
               </configuration>
               <executions>
                  <execution>
                     <phase>compile</phase>
                     <goals>
                        <goal>jar</goal>
                     </goals>
                  </execution>
               </executions>
            </plugin>
			
			<!-- 
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					for war
                  <mainClass>org.springframework.boot.loader.WarLauncher</mainClass>
                  <addResources>true</addResources>
				  <classifier>exec</classifier>
		          <fork>true</fork>如果没有该项配置，devtools不会起作用，即应用不会restart
		        </configuration>
			</plugin> 
			-->
		</plugins>
	</build>
</project>
