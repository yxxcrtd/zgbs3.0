<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
	<artifactId>service-disclosure</artifactId>
	<name>service-disclosure</name>
	<version>2.1.1</version>
	<packaging>jar</packaging>
<!-- 	<packaging>war</packaging> -->

	<properties>
		<start-class>com.joyintech.service.disclosure.DisclosureApplication</start-class>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-disclosure-busicommon</artifactId>
			<version>3.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
		</dependency>
		
        <dependency>
          <groupId>com.joyintech</groupId>
          <artifactId>framework-log</artifactId>
        </dependency>
        
        <dependency>
          <groupId>com.joyintech</groupId>
          <artifactId>framework-dtx</artifactId>
        </dependency>

        <dependency>
          <groupId>com.joyintech</groupId>
          <artifactId>framework-data</artifactId>
        </dependency>
	</dependencies>

	<build>
		<finalName>service-disclosure</finalName> 
		<plugins>
		<!-- 打包源代码插件 -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-source-plugin</artifactId>
               <version>2.4</version>
               <configuration>
                  <attach>true</attach>
               </configuration>
               <executions>
                  <execution>
                     <phase>compile</phase>
                     <goals>
                        <goal>jar</goal>
                     </goals>
                  </execution>
               </executions>
            </plugin>
			
			<!-- 
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					for war
					<mainClass>org.springframework.boot.loader.WarLauncher</mainClass>
					<addResources>true</addResources>
					<classifier>exec</classifier>
					<fork>true</fork>如果没有该项配置，devtools不会起作用，即应用不会restart
				</configuration>
			</plugin> 
			-->
		</plugins>
	</build>
</project>
