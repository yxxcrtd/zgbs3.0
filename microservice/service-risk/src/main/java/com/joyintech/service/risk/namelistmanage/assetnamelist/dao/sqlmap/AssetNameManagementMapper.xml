<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.risk.namelistmanage.assetnamelist.dao.AssetNameManagementMapper">
    <!--画面一分页查询-->
    <select id="queryForPage"  resultType="com.joyintech.service.risk.namelistmanage.assetnamelist.dto.RskAccessListDto" parameterType="Map">
        <choose>
            <when test="isEffFlag != null and isEffFlag.equals('01')">
                SELECT
                LIST_ID LIST_ID,
                LIST_NAME LIST_NAME,
                LIST_TYPE LIST_TYPE,
                LIST_LEVEL LIST_LEVEL,
                EFFDATE,
                DELDATE, 
                WORKFLOW_ID,
                WORKFLOW_STATUS
                FROM
                WFL_RSK_ACCESS_LIST
                <where>
                    <if test="rskSubjectType != null and rskSubjectType != ''">
                        LIST_DETAIL_TYPE  = #{rskSubjectType}
                    </if>
                    <if test="listIdList != null and listIdList.size() > 0">
                        AND LIST_ID IN
                        <foreach collection="listIdList" item="item" open="(" close=")" separator=",">
                            #{item}
                        </foreach>
                    </if>
                </where>
                UNION
            </when>
        </choose>
        SELECT
        LIST_ID LIST_ID,
        LIST_NAME LIST_NAME,
        LIST_TYPE LIST_TYPE,
        LIST_LEVEL LIST_LEVEL,
        EFFDATE,
        DELDATE,
        NULL WORKFLOW_ID,
        NULL WORKFLOW_STATUS
        FROM
        RSK_ACCESS_LIST
        WHERE
        LIST_ID not in
        (
            SELECT LIST_ID LIST_ID FROM WFL_RSK_ACCESS_LIST
            <where>
                <if test="rskSubjectType != null and rskSubjectType != ''">
                    LIST_DETAIL_TYPE  = #{rskSubjectType}
                </if>
                <if test="listIdList != null and listIdList.size() > 0">
                    AND LIST_ID IN
                    <foreach collection="listIdList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
            </where>
        )
        <if test="listName != null and listName != ''">
            AND LIST_NAME  LIKE CONCAT('%', CONCAT(#{listName}, '%'))
        </if>
        <choose>
            <when test="isEffFlag != null and isEffFlag.equals('01')">
                <![CDATA[AND  (DELDATE > #{sysDate} ]]> or EFFDATE &lt;= #{sysDate})
            </when>
            <otherwise>
                <![CDATA[AND  DELDATE <= #{sysDate} ]]>
            </otherwise>
        </choose>
        <if test="rskSubjectType != null and rskSubjectType != ''">
            AND LIST_DETAIL_TYPE  = #{rskSubjectType}
        </if>
        <if test="listIdList != null and listIdList.size() > 0">
            AND LIST_ID IN
            <foreach collection="listIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
	</select>

    <!--名单明细画面一分页查询-->
    <select id="queryDetailForPage"  resultType="com.joyintech.service.risk.namelistmanage.assetnamelist.dto.RskAccessListDetailDto" parameterType="Map">
        SELECT
        LIST_ID LIST_ID,
        LIST_DATE LIST_DATE,
        LIST_DETAIL_NAME LIST_DETAIL_NAME,
        LIST_DETAIL_ID LIST_DETAIL_ID,
        LIST_DETAIL_TYPE LIST_DETAIL_TYPE,
        OPERATE_TYPE OPERATE_TYPE,
        REMARK REMARK,
        LIST_DETAIL_NAME oldlistDetailName
        ,INSTITUTION_CODE /*add by songyawei 二级法人改造 20200708 */
        FROM
        RSK_ACCESS_LIST_DETAIL
        <where>
            <if test="listId != null and listId != ''">
                  LIST_ID = #{listId,jdbcType=VARCHAR}
                 <!-- AND LIST_DATE = (SELECT MAX(LIST_DATE) FROM RSK_ACCESS_LIST_DETAIL WHERE LIST_ID = #{listId,jdbcType=VARCHAR}
                  <![CDATA[AND  LIST_DATE <= #{sysDate} ]]>) -->
            </if>
            <if test="listDetailId != null and listDetailId != ''">
                AND LIST_DETAIL_ID  LIKE CONCAT('%', CONCAT(#{listDetailId}, '%'))
            </if>
            <if test="listDetailName != null and listDetailName != ''">
                AND LIST_DETAIL_NAME  LIKE CONCAT('%', CONCAT(#{listDetailName}, '%'))
            </if>
        </where>
    </select>

    <!--名单联想下拉框  多选-->
    <select id="selectListId" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT DISTINCT
            LIST_ID id,
            LIST_NAME text
        FROM RSK_ACCESS_LIST
        <where>
            <if test="search != null and search != ''">
                (LIST_ID LIKE CONCAT('%', CONCAT(#{search}, '%'))
                OR
                LIST_NAME LIKE CONCAT('%', CONCAT(#{search}, '%'))
                )
            </if>
            <if test="initValue != null and initValue != ''">
                AND LIST_ID = #{initValue}
            </if>
            <if test="listDetailType != null and listDetailType != ''">
                AND LIST_DETAIL_TYPE = #{listDetailType}
            </if>
        </where>
    </select>

</mapper>