<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>component-business</artifactId>
	<name>component-business</name>
	<description>业务组件库</description>


	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
	<properties>
		<java.version>1.8</java.version>
		<junit.version>4.12</junit.version>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-tools</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-workflow</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-system</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
        </dependency>
		<!-- 算法 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-calculation</artifactId>
			<version>2.0.6</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>component-base</artifactId>
			<version>0.0.1</version>
		</dependency>
	</dependencies>

	<build>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.1</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>

			<!-- 打包源代码插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<attach>true</attach>
				</configuration>
				<executions>
					<execution>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<!-- 所有接口类作为一个jar -->
					<execution>
						<id>interf</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>interf</classifier>
							<excludes>
								<!--注意这玩意从编译结果目录开始算目录结构 -->
								<exclude>**/**/impl/**</exclude>
							</excludes>
						</configuration>
					</execution>
					<!-- asset.jar -->
					<execution>
						<id>asset</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>asset</classifier>
							<includes>
								<include>**/asset/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- bond.jar -->
					<execution>
						<id>bond</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>bond</classifier>
							<includes>
								<include>**/bond/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- buyback.jar -->
					<execution>
						<id>buyback</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>buyback</classifier>
							<includes>
								<include>**/buyback/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- cashflow.jar -->
					<execution>
						<id>cashflow</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>cashflow</classifier>
							<includes>
								<include>**/cashflow/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- current.jar -->
					<execution>
						<id>current</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>current</classifier>
							<includes>
								<include>**/current/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- fund.jar -->
					<execution>
						<id>fund</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>fund</classifier>
							<includes>
								<include>**/fund/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- lend.jar -->
					<execution>
						<id>lend</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>lend</classifier>
							<includes>
								<include>**/lend/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- report.jar -->
					<execution>
						<id>report</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>report</classifier>
							<includes>
								<include>**/report/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- serial.jar -->
					<execution>
						<id>serial</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>serial</classifier>
							<includes>
								<include>**/serial/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- standard.jar -->
					<execution>
						<id>standard</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>standard</classifier>
							<includes>
								<include>**/standard/impl/**</include>
							</includes>
						</configuration>
					</execution>
					<!-- prod.jar -->
					<execution>
						<id>prod</id>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>prod</classifier>
							<includes>
								<include>**/prod/impl/**</include>
								<include>src/main/resources/**</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<version>0.0.1</version>
</project>
