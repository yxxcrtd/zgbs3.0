<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.tams.invest.common.component.base.entrust.impl.dao.BaseEtrInvestInfoMapper">
	<resultMap id="EtrDistributeMap"
		type="com.joyintech.tams.common.base.entity.EtrDistribute">
		<id column="ENTRUST_ID" property="entrustId" jdbcType="VARCHAR" />
		<id column="TRADER" property="trader" jdbcType="VARCHAR" />
		<result column="REC_STATUS" property="recStatus" jdbcType="VARCHAR" />
		<result column="TRADING_HEADER" property="tradingHeader"
			jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<resultMap id="EtrFinishStatusMap"
		type="com.joyintech.tams.common.base.entity.EtrFinishStatus">
		<id column="ENTRUST_ID" property="entrustId" jdbcType="VARCHAR" />
		<id column="TRADE_ID" property="tradeId" jdbcType="VARCHAR" />
		<result column="FINISH_DATE" property="finishDate" jdbcType="DATE" />
		<result column="FINISH_AMT" property="finishAmt" jdbcType="DECIMAL" />
		<result column="TRADER" property="trader" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<resultMap id="EtrPledgeMap"
		type="com.joyintech.tams.common.base.entity.EtrPledge">
		<id column="ENTRUST_ID" property="entrustId" jdbcType="VARCHAR" />
		<id column="FINPROD_ID" property="finprodId" jdbcType="VARCHAR" />
		<result column="PLEDGE_FACE_VALUE" property="pledgeFaceValue"
			jdbcType="DECIMAL" />
		<result column="PLEDGE_NUMBER" property="pledgeNumber"
			jdbcType="DECIMAL" />
		<result column="PLEDGE_RATIO" property="pledgeRatio" jdbcType="DECIMAL" />
		<result column="PLEDGE_AMT" property="pledgeAmt" jdbcType="DECIMAL" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<resultMap id="BaseEtrFinishAmtDto"
		type="com.joyintech.tams.invest.common.component.base.entrust.dto.BaseEtrFinishAmtDto">
		<id column="ENTRUST_ID" property="entrustId" jdbcType="VARCHAR" />
		<result column="FINISH_AMT" property="finishAmt" jdbcType="DECIMAL" />
	</resultMap>
	<select id="selectEtrDistributeByPrimaryKey" resultMap="EtrDistributeMap"
		parameterType="com.joyintech.tams.common.base.entity.EtrDistributeKey">
		select
		ENTRUST_ID , TRADER , REC_STATUS , TRADING_HEADER ,
		CREATE_USER , CREATE_DEPT , CREATE_TIME , UPDATE_USER ,
		UPDATE_TIME
		from ETR_DISTRIBUTE
		<where>
			ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
			<if test="trader != null and trader != ''">
				AND	TRADER=#{trader,jdbcType=VARCHAR}
			</if>
		</where> 
	</select>
	<select id="selectEtrFinishStatusByPrimaryKey" resultMap="EtrFinishStatusMap"
		parameterType="com.joyintech.tams.common.base.entity.EtrFinishStatusKey">
		select
		ENTRUST_ID , TRADE_ID , FINISH_DATE ,
		FINISH_AMT , TRADER , CREATE_USER , CREATE_DEPT ,
		CREATE_TIME , UPDATE_USER , UPDATE_TIME
		from ETR_FINISH_STATUS
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
	</select>
	<select id="selectEtrPledgeByPrimaryKey" resultMap="EtrPledgeMap"
		parameterType="com.joyintech.tams.common.base.entity.EtrPledgeKey">
		select
		ENTRUST_ID , FINPROD_ID , PLEDGE_FACE_VALUE ,
		PLEDGE_NUMBER , PLEDGE_RATIO , PLEDGE_AMT , CREATE_USER ,
		CREATE_DEPT , CREATE_TIME , UPDATE_USER , UPDATE_TIME
		from ETR_PLEDGE
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
	</select>
	<select id="selectWflEtrPledgeByPrimaryKey" resultMap="EtrPledgeMap"
			parameterType="com.joyintech.tams.common.base.entity.EtrPledgeKey">
		select
			ENTRUST_ID , FINPROD_ID , PLEDGE_FACE_VALUE ,
			PLEDGE_NUMBER , PLEDGE_RATIO , PLEDGE_AMT , CREATE_USER ,
			CREATE_DEPT , CREATE_TIME , UPDATE_USER , UPDATE_TIME
		from WFL_ETR_PLEDGE
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
	</select>
	<select id="selectAllEtrDistribute" resultMap="EtrDistributeMap">
		select
		ENTRUST_ID , TRADER , REC_STATUS , TRADING_HEADER ,
		CREATE_USER , CREATE_DEPT , CREATE_TIME , UPDATE_USER ,
		UPDATE_TIME
		from ETR_DISTRIBUTE
	</select>
	<delete id="deleteEtrDistributeByPrimaryKey"
		parameterType="com.joyintech.tams.common.base.entity.EtrDistributeKey">
		delete from ETR_DISTRIBUTE
		<where> ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
		<if test="trader != null" >
			AND TRADER = #{trader,jdbcType=VARCHAR}
		</if>
		</where>
	</delete>
	<delete id="deleteEtrFinishStatusByPrimaryKey"
		parameterType="com.joyintech.tams.common.base.entity.EtrFinishStatusKey">
		delete from ETR_FINISH_STATUS
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
		<if test="tradeId != null and tradeId != ''">
			AND TRADE_ID = #{tradeId,jdbcType=VARCHAR}
		</if>
	</delete>
	<delete id="deleteEtrPledgeByPrimaryKey"
		parameterType="com.joyintech.tams.common.base.entity.EtrPledgeKey">
		delete from ETR_PLEDGE
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
	</delete>
	<update id="updateEtrDistributeByPrimaryKeySelective">
		update ETR_DISTRIBUTE
		set REC_STATUS=#{ENTRUST_RECEIVE_TYPE_HASCANCEL}
		<where>
			ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
			<if test="trader != null and trader != ''">
			AND TRADER = #{trader,jdbcType=VARCHAR}
			</if>
		</where> 
	</update>
	<select id="selectEtrFinishAmtDtoByPrimaryKey" resultMap="BaseEtrFinishAmtDto">
		select
		ENTRUST_ID ,
		SUM(FINISH_AMT) sumFinishAmt
		from ETR_FINISH_STATUS
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
		and ENTRUST_ID != TRADE_ID
		group by ENTRUST_ID
	</select>
	
	<delete id="deletByList">
		delete from ETR_DISTRIBUTE 
		<where>
			ENTRUST_ID in 
			<foreach collection="list" item="item" open="(" close=")" separator=",">
				#{item.entrustId}
			</foreach>
		</where>
	</delete>
    <!-- 删除投标标位表 -->
    <delete id="deleteBidPrice" parameterType="String"  >
        delete from ETR_ENTRUST_BID_PRICE
        where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
    </delete>
	<select id="selectByPrimaryKeyPtl" resultMap="com.joyintech.tams.common.base.dao.EtrEntrustMapper.BaseResultMap">
		select
		<include refid="com.joyintech.tams.common.base.dao.EtrEntrustMapper.Base_Column_List" />
		from ETR_ENTRUST
		<where>
			1=1
			<if test="entrustIdList != null and entrustIdList.size() > 0">
				and (ENTRUST_ID IN
				<foreach collection="entrustIdList" item="item" index="index" open="(" close=")" separator=",">
					<if test="(index % 998) == 0">
						null) OR ENTRUST_ID in (
					</if>
					#{item}
				</foreach>
				)
			</if>
		</where>
	</select>

	<select id="findInvAimByPortIdAndFinType" resultType="string">
		SELECT a.INV_AIM FROM INV_PTL_VAL_SCHEME_DETAIL a
		    inner join FIN_PRODUCT_TYPE b on a.TYPE_9 = b.TYPE_9 and (a.TYPE_10 is null or a.TYPE_10 = b.TYPE_10)
			and (A.TYPE_11 IS NULL OR A.TYPE_11 = B.TYPE_11) AND (A.TYPE_12 IS NULL OR A.TYPE_12 = B.TYPE_12)
		    inner join FIN_PRODUCT fp on b.FINPROD_ID = fp.FINPROD_ID AND (A.ISSUE_TYPE IS NULL or a.ISSUE_TYPE = fp.ISSUE_TYPE)
		WHERE b.FINPROD_ID = #{finprodId} and a.PORTFOLIO_ID = #{portfolioId}
	</select>

	<select id="findInvAimByPortIdAndFinId" resultType="string">
		SELECT INV_AIM FROM INV_BOK_VAL_SCHEME_SPECIAL WHERE PORTFOLIO_ID = #{portfolioId} and FINPROD_ID = #{finprodId}
	</select>
	<select id="selectAddByPrimaryKeyPtl" resultMap="com.joyintech.tams.common.base.dao.EtrEntrustAddMapper.BaseResultMap">
		select
		<include refid="com.joyintech.tams.common.base.dao.EtrEntrustAddMapper.Base_Column_List" />
		from ETR_ENTRUST_ADD
		<where>
			ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
		</where>
	</select>

	<select id="selectEtrClosedCashFlow" resultType="com.joyintech.tams.invest.common.dto.etr.EtrCashPositionFlowDto">
		SELECT <include refid="com.joyintech.tams.common.base.dao.EtrCashPositionFlowMapper.Base_Column_List" />
		FROM ETR_CASH_POSITION_FLOW WHERE CLOSE_FLAG='01' AND OFFSET_ID=#{entrustId}
	</select>

	<select id="selectEtrClosedSecFlow" resultType="com.joyintech.tams.invest.common.dto.etr.EtrSecPositionFlowDto">
		SELECT <include refid="com.joyintech.tams.common.base.dao.EtrSecPositionFlowMapper.Base_Column_List" />
		FROM ETR_SEC_POSITION_FLOW WHERE CLOSE_FLAG='01' AND TRADE_ID=#{entrustId}
	</select>

	<update id="updateEtrClosedCashFlow">
		UPDATE ETR_CASH_POSITION_FLOW SET CLOSE_FLAG='02' WHERE SEQNO=#{seqNo}
	</update>

	<update id="updateEtrClosedSecFlow">
		UPDATE ETR_SEC_POSITION_FLOW SET CLOSE_FLAG='02' WHERE SEQNO=#{seqNo}
	</update>
	
   	<update id="deleteDistributeInterfTmp"
		parameterType="java.util.HashMap">
		DELETE FROM ETR_DISTRIBUTE_INTERF_TMP
		WHERE ENTRUST_ID = #{entrustId}
	</update>

	<update id="updatEetrDistribute" parameterType="com.joyintech.tams.common.base.entity.EtrEntrust" >
		update ETR_DISTRIBUTE
		<set >
			<if test="entrustStatus != null" >
				REC_STATUS = #{entrustStatus,jdbcType=VARCHAR},
			</if>
		</set>
		where ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
	</update>

	<delete id="deleteEtrDistributeInterfTmp">
		DELETE FROM ETR_DISTRIBUTE_INTERF_TMP  WHERE ENTRUST_ID = #{entrustId,jdbcType=VARCHAR}
	</delete>
	<delete id="deleteEntrustDetail" parameterType="java.lang.String" >
		DELETE FROM ETR_ENTRUST_DETAIL
		WHERE ENTRUST_ID  = #{entrustId, jdbcType=VARCHAR}
	</delete>

</mapper>