    <select id="findProductByIds" resultType="com.joyintech.framework.base.dto.Product">
        select
        PORTFOLIO_ID prodId,
        PORTFOLIO_NAME prodName
        from PTL_PORTFOLIO
        where
        PORTFOLIO_TYPE != #{PORTFOLIO_TYPE_02}
        <if test="prodGroupSeqNos != null">
            AND PORTFOLIO_ID IN
            <foreach collection="prodGroupSeqNos" item="item" open="( " close=" )" separator=",">
                #{item}
            </foreach>
        </if>
    </select>
    
    <select id="findProductByName" resultType="com.joyintech.framework.base.dto.Product">
        <!--select
        BOOKSET_ID prodId,
        BOOKSET_NAME prodName
        from BOK_BOOKSET
        where
        1 = 1
        <if test="notInProductIds != null and notInProductIds.size() > 0">
            AND BOOKSET_ID NOT IN
            <foreach collection="notInProductIds" item="item" open="( " close=" )" separator=",">
                #{item}
            </foreach>
        </if>
        <if test="prodName != null and prodName != ''">
            AND (UPPER(BOOKSET_NAME) LIKE concat(concat('%', UPPER(#{prodName})),'%') OR UPPER(BOOKSET_ID) LIKE concat(concat('%', UPPER(#{prodName})),'%') )
        </if> -->
        <!-- add by wujie on 20190328 start -->
        <!--<if test="acctSubjectTypeNo !=null and acctSubjectTypeNo !='' ">
            and ACCT_SUBJECT_TYPE != #{acctSubjectTypeNo}
        </if> -->
        <!-- add by wujie on 20190328 end -->
        select
        PORTFOLIO_ID prodId,
        PORTFOLIO_NAME prodName
        from PTL_PORTFOLIO
        where
        PORTFOLIO_TYPE != #{PORTFOLIO_TYPE_02}
        <if test="notInProductIds != null and notInProductIds.size() > 0">
            AND PORTFOLIO_ID NOT IN
            <foreach collection="notInProductIds" item="item" open="( " close=" )" separator=",">
                #{item}
            </foreach>
        </if>
        <if test="prodName != null and prodName != ''">
            AND (UPPER(PORTFOLIO_NAME) LIKE concat(concat('%', UPPER(#{prodName})),'%') OR UPPER(PORTFOLIO_ID) LIKE concat(concat('%', UPPER(#{prodName})),'%') )
        </if>
    </select>
