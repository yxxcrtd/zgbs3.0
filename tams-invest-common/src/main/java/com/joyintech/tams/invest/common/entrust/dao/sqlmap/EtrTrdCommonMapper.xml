<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.entrust.dao.EtrTrdCommonMapper">



    <select id="getPtlAcctInfo" resultType="com.joyintech.tams.common.base.entity.PtlCapacctInfo">
        select t.ACCT_NO,t.ACCT_TYPE
        from PTL_CAPACCT_INFO t
        where t.PORTFOLIO_ID = #{portfolioId}
        <if test="acctTypeList != null and !acctTypeList.isEmpty() ">
            <foreach collection="acctTypeList" open=" and ACCT_TYPE in (" close=")" item="item" separator=",">#{item}</foreach>
        </if>
    </select>

    <select id="getDealCalendarHoliday" resultType="java.lang.String">
        select
        to_char(CDATE, 'yyyy-MM-dd') as HOLIDATE
        from
        VAL_VW_MST_HOLIDAY
        where
        IS_HOLIDAY > 0
        <if test="startDate != null">
            and CDATE >= #{startDate, jdbcType=DATE}
        </if>
        <if test="endDate != null">
            and CDATE &lt;= #{endDate, jdbcType=DATE}
        </if>
        <if test="dealCalId != null and dealCalId != ''">
            and TRADE_CALENDAR_ID = #{dealCalId}
        </if>
    </select>


    <select id="selectFaceValue" resultType="java.math.BigDecimal">
        SELECT 100 - sum(nvl(PRIN_AMT,0 ))
        FROM FIN_CASH_PLAN
        WHERE FINPROD_ID=#{finprodId}
          AND #{sysDate} >= MDATE
    </select>

    <select id="getFirstTradeAmtByTradeId" resultType="java.math.BigDecimal">
        select ftp.M_TRADE_AMT from FIN_TRADE_PRODUCT ftp where ftp.FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
    </select>

    <select id="getFinProductAddBatch" resultType="com.joyintech.tams.common.base.entity.FinProductAdd">
        select
        <include refid="com.joyintech.tams.common.base.dao.FinProductAddMapper.Base_Column_List" />
        from FIN_PRODUCT_ADD
        where
        1 = 1
        <if test="finprodIds != null and !finprodIds.isEmpty() ">
            AND FINPROD_ID in
            <foreach collection="finprodIds" item="item" index="index" open="(" separator="," close=")">
                <if test="(index % 999) == 998">
                    null) OR FINPROD_ID in (
                </if>
                #{item}
            </foreach>
        </if>
    </select>
</mapper>