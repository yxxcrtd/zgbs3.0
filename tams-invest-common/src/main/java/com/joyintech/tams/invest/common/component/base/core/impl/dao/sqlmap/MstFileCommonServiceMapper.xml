<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.component.base.core.impl.dao.MstFileCommonServiceMapperImpl">
	<update id ="updateFileBusinessId">
		update SYS_UPLOAD_FILE_INFO
		SET BUSINESS_ID = #{businessId,jdbcType=VARCHAR}
		<foreach collection="uploadFileList" item = "item" open="where SEQ_NO in(" close=")" separator="," >
			#{item.seqNo,jdbcType=VARCHAR}
		</foreach>
	</update>
	<select id="getUploadInfo" resultType="com.joyintech.tams.common.base.entity.SysUploadFileInfo">
		SELECT
		    sufi.SEQ_NO as seqNo,
		    sufi.FILE_NAME as fileName,
		    sufi.PATH as "path",
		    sufi.BUSINESS_ID as businessId,
		    sufi.CREATE_USER as createUser,
		    sufi.CREATE_TIME as createTime,
		    sufi.UPDATE_USER as updateUser,
		    sufi.UPDATE_TIME as updateTime
		FROM
		    SYS_UPLOAD_FILE_INFO sufi
		<where>
			<if test="bussinessId != null and bussinessId!=''">
				sufi.BUSINESS_ID = #{bussinessId}
			</if>
			<if test="fileName != null and fileName !=''">
				sufi.FILE_NAME = #{fileName}
			</if>
		</where>
	</select>
</mapper>