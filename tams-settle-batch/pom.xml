<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.joyintech</groupId>
        <artifactId>batch-base</artifactId>
        <version>2.1.6.3</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tams-settle-batch</artifactId>
    <name>清结算批处理</name>
    <version>2.0</version>

    <properties>
        <jackson.version>2.9.2</jackson.version>
        <framework.version>0.0.4</framework.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>batch-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>framework-core</artifactId>
            <version>0.0.4</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>joyintech-system</artifactId>
            <version>0.0.4</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-data</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-log</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>framework-security</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>joyintech-system</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.joyintech</groupId>
                    <artifactId>joyintech-workflow</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-invest-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-settle-common</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <version>1.5.9.RELEASE</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>component-business</artifactId>
            <version>0.0.1</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- <finalName>tams-settle-batch</finalName> -->
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--for war-->
                    <!-- <mainClass>org.springframework.boot.loader.WarLauncher</mainClass>-->
                    <!-- <addResources>true</addResources>-->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>/**/ServletInitializer.class</exclude>
                        <exclude>/**/banner.txt</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.properties</include>
                    <include>**/*.ini</include>
                    <include>**/*.yml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
