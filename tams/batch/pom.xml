				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-settle-batch</artifactId>
			<version>2.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-svreport-batch-chb</artifactId>
			<version>3.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-svreport-batch-chb3</artifactId>
			<version>3.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-svreport-batch-pbc</artifactId>
			<version>3.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-svreport-batch-svr</artifactId>
			<version>3.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-disclosure-batch</artifactId>
			<version>3.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-core</artifactId>
			<version>0.0.5.alibaba</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>batch-framework</artifactId>
			<exclusions>
				<exclusion>
					<artifactId>framework-data</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>framework-data</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common-customer</artifactId>
