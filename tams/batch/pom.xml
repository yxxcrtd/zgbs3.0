  <artifactId>tams-batch</artifactId>
  <version>1.9.0.0.0</version>
  <name>tams-batch</name>
  <packaging>jar</packaging>
  <description>理财资管系统-批处理整合启动工程</description>

  <properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<hibernate.version>5.3.6.Final</hibernate.version>
        <jackson.version>2.9.2</jackson.version>
	    <framework.version>0.0.4</framework.version>
	</properties>
	<dependencies>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-valuation-batch</artifactId>
			<version>3.0.1</version>
			<exclusions>
				<exclusion>
					<artifactId>framework-core</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>batch-framework</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>framework-security</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>framework-web</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>framework-data</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>pagehelper</artifactId>
					<groupId>com.github.pagehelper</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-valuation-batch-valmodel</artifactId>
