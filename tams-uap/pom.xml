<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
		<relativePath/>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tams-uap</artifactId>
	<name>用户应用平台(UserApplicationPlatform)</name>
	<version>4.0.0</version>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
        <hibernate.version>5.3.6.Final</hibernate.version>
	</properties>

	<dependencies>

		<!-- 集成微服务端的代码 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-service-container-touguan</artifactId>
			<version>2.1.1</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-web</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-data</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-log</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-security</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-tools</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-system</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-workflow</artifactId>
		</dependency>
        <!-- 投管画面端 -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-invest</artifactId>
            <version>1.0.0</version>
			<exclusions>
					<exclusion>
						<groupId>org.springframework.boot</groupId>
			            <artifactId>spring-boot-starter-tomcat</artifactId>
					</exclusion>
		    </exclusions>
        </dependency>

		<!-- 交易画面端 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-exchange-trade</artifactId>
			<version>3.0.0</version>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- 接口画面端 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-customer-interf</artifactId>
			<version>1.0</version>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

        <!-- 移动APP -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>itext-asian</artifactId>
			<version>3.0.1</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>itextpdf</artifactId>
			<version>5.5.8</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>jodconverter</artifactId>
			<version>2.2.2</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>jodconverter-core</artifactId>
			<version>3.0-beta-4</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>juh</artifactId>
			<version>3.0.1</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>ridl</artifactId>
			<version>3.0.1</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>unoil</artifactId>
			<version>3.0.1</version>
		</dependency>
				<!-- 公共基础数据画面 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common-basicdata</artifactId>
			<version>2.1.1.3</version>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!--银行间-->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-cfets</artifactId>
			<version>3.0.4</version>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

	</dependencies>
	
	<build>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
				<filtering>false</filtering>
			</resource>
			<resource>
	            <directory>src/main/resources</directory>
	            <includes>
	                <include>**/*</include>
	            </includes>
	            <filtering>false</filtering>
	        </resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.joyintech.PlatformApplication</mainClass>
					<includeSystemScope>true</includeSystemScope>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>