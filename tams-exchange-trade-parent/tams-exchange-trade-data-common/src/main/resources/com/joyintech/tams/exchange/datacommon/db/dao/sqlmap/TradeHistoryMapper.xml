            </if>
            <if test="stockCode != null and stockCode != ''">
                AND a.STOCK_CODE = #{stockCode}
            </if>
            <if test="entrustProp != null and entrustProp != ''">
                AND a.ENTRUST_PROP = #{entrustProp}
            </if>
            <if test="startDay != null and startDay != ''">
                AND a.TRADING_DAY &gt;= #{startDay}
            </if>
            <if test="endDay != null and endDay != ''">
                AND a.TRADING_DAY &lt;= #{endDay}
            </if>
            <if test="portfolioList != null and portfolioList.size()>0">
                AND a.PORTFOLIO_ID in
                <foreach collection="portfolioList" item="portfolioCode" index="index" open="(" close=")" separator=",">
                    #{portfolioCode,jdbcType=VARCHAR}
                </foreach>
            </if>
        </where>
    </sql>

