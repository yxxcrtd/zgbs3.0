<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.5.alibaba</version>
	</parent>
	<artifactId>tams-customer-interf</artifactId>
	<version>1.0</version>
	<name>tams-customer-interf</name>
	<description>自定义接口工程</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.quartz-scheduler</groupId>
			<artifactId>quartz</artifactId>
			<version>2.3.0</version>
		</dependency>
		<dependency>
			<groupId>org.quartz-scheduler</groupId>
			<artifactId>quartz-parent</artifactId>
			<version>2.3.0</version>
			<type>pom</type>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-system</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-security</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
		
		<dependency>
		   <groupId>com.joyintech</groupId>
		   <artifactId>component-business</artifactId>
		   <version>0.0.1</version>
		</dependency>
		<dependency>
		   <groupId>com.joyintech</groupId>
		   <artifactId>tams-invest-product</artifactId>
		   <version>1.0.0</version>
			<exclusions>
				<exclusion>
					<groupId>com.joyintech</groupId>
					<artifactId>framework-dtx</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-entrust</artifactId>
			<version>1.0.0</version>
			<exclusions>
				<exclusion>
					<groupId>com.joyintech</groupId>
					<artifactId>framework-dtx</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
        
<!--         添加深圳通的连接包 -->
		<dependency>
		   <groupId>com.joyintech</groupId>
		   <artifactId>connector</artifactId>
		   <version>1.0</version>
		</dependency>
     <!--    <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>RELEASE</version>
            <scope>compile</scope>
        </dependency>
        
-->
    </dependencies>
	
	<build>
        <finalName>tams-customer-interf</finalName>
        <plugins>
		<!-- 打包源代码插件 -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-source-plugin</artifactId>
               <version>2.4</version>
               <configuration>
                  <attach>true</attach>
               </configuration>
               <executions>
                  <execution>
                     <phase>compile</phase>
                     <goals>
                        <goal>jar</goal>
                     </goals>
                  </execution>
               </executions>
            </plugin>
			
<!--            <plugin>-->
<!--                <groupId>org.springframework.boot</groupId>-->
<!--                <artifactId>spring-boot-maven-plugin</artifactId>-->
<!--            </plugin>-->
        </plugins>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
				<filtering>true</filtering>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.xml</include>
					<include>**/*.txt</include>
					<include>**/*.png</include>
					<include>**/*.properties</include>
					<include>**/*.ini</include>
					<include>**/*.yml</include>
					<include>**/*.js</include>
					<include>**/*.html</include>
					<include>**/*.xls</include>
				</includes>
				<filtering>false</filtering>
			</resource>
		</resources>
    </build>
</project>
