<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.joyintech</groupId>
        <artifactId>batch-base</artifactId>
        <version>2.1.6.3</version>
    </parent>
    <artifactId>tams-svreport-batch</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>
    <modules>
		<module>tams-svreport-batch-svr</module>
        <module>tams-svreport-batch-chb</module>
        <module>tams-svreport-batch-chb3</module>
        <module>tams-svreport-batch-pbc</module>
    </modules>

    <properties>
        <framework.version>0.0.4</framework.version>
    </properties>

    <dependencies>
         <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>batch-framework</artifactId>
            <version>2.1.6.3</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-svreport-interf</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>framework-log</artifactId>
            <version>0.0.5.alibaba</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
	<build>
	   <plugins>
		  <!-- 打包源代码插件 -->
		  <plugin>
			 <groupId>org.apache.maven.plugins</groupId>
			 <artifactId>maven-source-plugin</artifactId>
			 <version>2.4</version>
			 <configuration>
				<attach>true</attach>
			 </configuration>
			 <executions>
				<execution>
				   <phase>compile</phase>
				   <goals>
					  <goal>jar</goal>
				   </goals>
				</execution>
			 </executions>
		  </plugin>
	   </plugins>
	</build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-tomcat</artifactId>
                <version>1.5.9.RELEASE</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


</project>
