<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.cfets.etr.bondfirstbid.dao.CfetsEtrBondFirstBid002Mapper">

    <delete id="deleteEntrustBidPriceByEntrustId" parameterType="java.lang.String" >
        DELETE FROM ETR_ENTRUST_BID_PRICE
        WHERE ENTRUST_ID  = #{workflowId, jdbcType=VARCHAR}
    </delete>
    <delete id="deleteEntrustDetailByEntrustId" parameterType="java.lang.String" >
        DELETE FROM ETR_ENTRUST_DETAIL
        WHERE ENTRUST_ID  = #{workflowId, jdbcType=VARCHAR}
    </delete>
</mapper>