<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <springProperty scope="context" name="loglevel" source="log.level" defaultValue="INFO"/>
    <springProperty scope="context" name="logfolder" source="log.path"/>
    <logger name="com.ibm.ws.webcontainer.srt.SRTServletResponse" level="OFF" />
    <logger name="com.ibm.ws.webcontainer.servlet.ServletWrapper" level="OFF" />
    <!-- 参数设置 -->
	<include resource="logback-base.xml"/>
	
    <!-- 日志级别 -->
    <root level="${loglevel}">
        <appender-ref ref="file" />
        <appender-ref ref="error" />
        <appender-ref ref="console" />
    </root>
</configuration>