<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="ActualTimeAsset001.xlsx" name="实时资产头寸查询">
    <Worksheet javaBean="com.joyintech.tams.invest.portfolio.actualtimeasset.dto.ActualTimeAssetDto">
        <Row>
            <Cell order="1" name="组合名称">portfolioName</Cell>
            <Cell order="2" name="证券账户">secAcctInfo</Cell>
            <Cell order="3" name="资产类型">type8Name</Cell>
            <Cell order="4" name="资产二级类型">type9Str</Cell>
            <Cell order="5" name="资产代码">finprodMarketId</Cell>
