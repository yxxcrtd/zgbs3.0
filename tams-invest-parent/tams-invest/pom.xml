		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tams-invest-report</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tams-invest-risk</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tams-invest-riskredis</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tams-invest-settle</artifactId>
			<version>${project.version}</version>
